KIT19_WHATSAPP_URL=https://services.kit19.com/IMS/Whatsapp/Template
KIT19_WHATSAPP_KEY=replace_with_your_key
KIT19_WHATSAPP_USERNAME=replace_with_your_username
# Optional in production, for example: https://example.com
FEEDBACK_BASE_URL=
# Optional fixed test URL. Use {token} if the page accepts a token.
FEEDBACK_STATIC_URL=https://anandjewels.com/feedback.html?utm_src=queue
# true for local immediate testing; false for scheduled sending
FEEDBACK_IMMEDIATE_SEND=false
# Hours after queue registration to send WhatsApp (calculated/displayed in IST)
FEEDBACK_DELAY_HOURS=5
CRE_API_BASE_URL=http://127.0.0.1:8501
CRE_INTEGRATION_KEY=replace-with-secure-integration-key
DATABASE_URL=sqlite:///./gold_rates.db
SESSION_SECRET_KEY=replace-with-long-random-secret
